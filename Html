<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bvaide Jewellery | Timeless Luxury</title>
    <style>
        body {
            background-color: #fafafa;
            font-family: 'Garamond', serif;
            color: #222;
            margin: 0;
            padding: 0;
        }
        /* Navbar style */
        .nav {
            padding: 20px;
            background: white;
            text-align: center;
            border-bottom: 1px solid #eee;
            letter-spacing: 4px;
            font-size: 0.8rem;
        }
        /* Header section */
        .hero {
            background-color: #fff;
            padding: 80px 20px;
            text-align: center;
            border-bottom: 4px solid #d4af37;
        }
        h1 {
            color: #b8860b;
            font-size: 3rem;
            margin: 0;
            font-weight: lighter;
            letter-spacing: 8px;
        }
        .tagline {
            font-style: italic;
            color: #999;
            margin-top: 15px;
            font-size: 1.2rem;
        }
        /* Gallery Section */
        .section {
            padding: 60px 20px;
            max-width: 1000px;
            margin: auto;
            text-align: center;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }
        .card {
            background: white;
            padding: 40px 20px;
            border: 1px solid #f0f0f0;
            transition: 0.3s;
        }
        .card:hover {
            border-color: #d4af37;
            transform: translateY(-5px);
        }
        .card h3 {
            color: #b8860b;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-size: 1.1rem;
        }
        /* Contact Button */
        .cta-btn {
            background-color: #222;
            color: white;
            padding: 18px 40px;
            text-decoration: none;
            display: inline-block;
            margin-top: 40px;
            letter-spacing: 2px;
            font-size: 0.9rem;
            transition: 0.4s;
        }
        .cta-btn:hover {
            background-color: #d4af37;
        }
        footer {
            padding: 40px;
            background: #111;
            color: #666;
            font-size: 0.8rem;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="nav">COLLECTIONS • ABOUT • CONTACT</div>

    <div class="hero">
        <h1>BVAIDE</h1>
        <p class="tagline">Handcrafted Elegance Since 2026</p>
    </div>

    <div class="section">
        <h2>THE COLLECTIONS</h2>
        <div class="grid">
            <div class="card">
                <h3>Rings</h3>
                <p>Pure Gold & Diamond Bands</p>
            </div>
            <div class="card">
                <h3>Necklaces</h3>
                <p>Statement Pieces for Every Occasion</p>
            </div>
            <div class="card">
                <h3>Bracelets</h3>
                <p>Elegance on Your Wrist</p>
            </div>
        </div>
        
        <a href="https://wa.me/YOURNUMBER" class="cta-btn">INQUIRE VIA WHATSAPP</a>
    </div>

    <footer>
        © 2026 BVAIDE JEWELLERY. ALL RIGHTS RESERVED.
    </footer>

</body>
</html>
